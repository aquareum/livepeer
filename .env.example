# Copy to .env and fill in. .env is never committed.

# Base URL of the pinned livepeer-builder engine's REST API.
ENGINE_URL=
# Engine admin token: operator actions that change something, and provisioning a builder account at sign-up. Server-side only.
ENGINE_ADMIN_TOKEN=
# Engine reader token: read-only operator data across all builders. Server-side only.
ENGINE_READER_TOKEN=
# Local development shortcut only: signs you in as one fixed builder (lpk_...). Leave empty in production.
BUILDER_API_KEY=
# Secret (32+ characters) used to seal the session cookie that holds the signed-in user's builder key.
SESSION_SECRET=
# Set to 1 to force every API function to its mock implementation (tests, CI, offline demos, first run without engine keys).
MOCK_ONLY=
# Path to the instance config file. Defaults to ./instance.config.json.
INSTANCE_CONFIG=
# The instance config itself, as JSON on one line, for hosts with no file to mount. Wins over INSTANCE_CONFIG.
INSTANCE_CONFIG_JSON=
# Postgres the instance keeps its own state in. Leave empty with the Compose bundle, which uses its own; set it to use a Postgres you run, or the pooled address on a serverless host. Empty outside the bundle: the app runs a Postgres inside itself, kept in DATA_DIR, which suits development and a first look.
DATABASE_URL=
# Direct (not pooled) address of the same database, used only to run migrations when DATABASE_URL is a pooled address. Empty: DATABASE_URL is used.
DATABASE_URL_UNPOOLED=
# Password of the Compose bundle's own Postgres. Generated by `livepeer setup`.
POSTGRES_PASSWORD=
# Secrets of the Compose bundle's own object storage (Garage): the node's RPC secret, its admin token, and the id and secret of the key the app signs with. Generated by `livepeer setup`. Unused when S3_ENDPOINT names another service.
STORAGE_RPC_SECRET=
STORAGE_ADMIN_TOKEN=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_KEY=
# Where the app keeps what it holds itself when it was given nowhere else: the Postgres it runs when DATABASE_URL is empty, and uploaded files when S3_BUCKET is empty. Defaults to ./.data; the Docker image uses /data.
DATA_DIR=
# Object storage for uploaded files, through the S3 API: Cloudflare R2, AWS S3, Backblaze B2 or a server you run. Setting the bucket turns it on. Leave all of these empty with the Compose bundle to use its own storage. Empty outside the bundle: files are kept on the app's own disk in DATA_DIR, which suits development, and can't work on a host with no disk.
S3_BUCKET=
# A key that may read, write and delete objects in that bucket and nothing else. Server-side only: clients are given a signed address for one file, never the key.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The bucket's region: "auto" on R2. Empty: us-east-1.
S3_REGION=
# The storage service's address as the app's server reaches it. Empty: AWS outside the bundle; inside it, the bundle's own storage (for AWS there, give its address: https://s3.<region>.amazonaws.com, with S3_FORCE_PATH_STYLE=false).
S3_ENDPOINT=
# The same service as browsers and phones reach it, only when that differs from S3_ENDPOINT (a service on a private network behind a public address). Signed addresses are made for this one. "app" when they can't reach it at all: files then pass through the app's own address, as with the bundle's storage.
S3_PUBLIC_ENDPOINT=
# "true" puts the bucket in the path, "false" in the host name. Empty: the path when S3_ENDPOINT is set, the host name on AWS.
S3_FORCE_PATH_STYLE=
# Only on a host with no server between requests (Vercel): the secret a scheduler sends as a bearer token to /api/cron/alerts every minute, to run the checks behind operators' alerts. Setting it stops the app's own timer, so leave it empty wherever the server stays running.
CRON_SECRET=
# Set to 1 to let the test sign-in (auth.provider "mock") answer on a public address. It signs anyone in as a sample user or the sample operator, so without this a production build offers it only to the machine it runs on and private networks, and never on an instance that names a public domain. For an open demo, or one something else protects.
ALLOW_TEST_SIGN_IN=
# OIDC client secret, when auth.provider is "oidc" and the provider needs one.
OIDC_CLIENT_SECRET=
# Host port the app listens on.
APP_PORT=
# Image registry, organisation and pinned versions. Written by `livepeer setup` from release.config.json.
REGISTRY=
ORG=
APP_VERSION=
ENGINE_REPO=
ENGINE_REF=
PROVIDER_REPO=
PROVIDER_REF=
SIGNER_REF=
# Bearer token that lets an agent administer the instance through /api/v1/operator/* and MCP. Leave empty to disable.
OPERATOR_API_TOKEN=
# Alerts to operators' iPhones (optional): the APNs authentication key from the app's Apple Developer team, as base64 on one line (base64 -i AuthKey_XXXXXXXXXX.p8). Server-side only.
APNS_KEY=
# The 10-character id of that APNs key.
APNS_KEY_ID=
# The 10-character Apple Developer team id the key belongs to.
APNS_TEAM_ID=
# Alerts to operators' Android phones (optional): the Firebase service account's JSON file, as base64 on one line. It should be allowed to send messages and nothing else. Server-side only.
FCM_SERVICE_ACCOUNT=
